# Что oxfmt не форматирует. Файл нужен потому, что без --ignore-path oxfmt читает
# .gitignore, а стиль в шаблоне держится только на исходниках проекта.
node_modules/
# oxfmt форматирует не только js и ts: package.json он переписывает в свой вид,
# а эти файлы ведут другие инструменты, npm и редактор.
*.yml
*.yaml
*.json
*.md
dist/
coverage/
