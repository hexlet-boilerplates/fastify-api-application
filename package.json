{
  "name": "fastify-api-application",
  "version": "1.0.0",
  "description": "Стартовый шаблон REST API на Fastify и TypeScript для курса «JS: REST API (Fastify)»",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "fastify start -l info src/app.ts",
    "dev": "fastify start -w -l info -P src/app.ts",
    "check-types": "tsc",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "@fastify/autoload": "^6.5.1",
    "@fastify/sensible": "^6.0.7",
    "fastify-cli": "8.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "typescript": "~7.0.2"
  }
}
